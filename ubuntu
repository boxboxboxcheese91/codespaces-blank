<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Spinning A</title>
    <style>
      :root {
        --bg1: #0f172a;
        --bg2: #111827;
        --a1: #f8fafc;
        --a2: #38bdf8;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: radial-gradient(circle at center, var(--bg2), var(--bg1));
        overflow: hidden;
        font-family: Arial, Helvetica, sans-serif;
      }

      .scene {
        width: min(70vmin, 420px);
        aspect-ratio: 1;
        display: grid;
        place-items: center;
        perspective: 1200px;
      }

      .spinner {
        position: relative;
        width: 55%;
        aspect-ratio: 1;
        display: grid;
        place-items: center;
        transform-style: preserve-3d;
        animation: spin 3s linear infinite;
      }

      .a {
        position: relative;
        width: 100%;
        height: 100%;
        display: grid;
        place-items: center;
        color: var(--a1);
        text-shadow: 0 0 24px rgba(56, 189, 248, 0.7), 0 0 40px rgba(248, 250, 252, 0.35);
        font-size: clamp(130px, 28vmin, 260px);
        font-weight: 900;
        line-height: 1;
        transform: rotateX(18deg) rotateY(18deg);
      }

      .a::before,
      .a::after {
        content: "A";
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
      }

      .a::before {
        color: rgba(56, 189, 248, 0.7);
        transform: translateZ(-18px) scale(0.96);
      }

      .a::after {
        color: rgba(248, 250, 252, 0.35);
        transform: translateZ(18px) scale(1.04);
      }

      @keyframes spin {
        0%   { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg); }
        25%  { transform: rotateX(180deg) rotateY(90deg) rotateZ(45deg); }
        50%  { transform: rotateX(360deg) rotateY(180deg) rotateZ(90deg); }
        75%  { transform: rotateX(180deg) rotateY(270deg) rotateZ(135deg); }
        100% { transform: rotateX(0deg) rotateY(360deg) rotateZ(180deg); }
      }
    </style>
  </head>
  <body>
    <div class="scene">
      <div class="spinner">
        <div class="a">A</div>
      </div>
    </div>
  </body>
</html>
